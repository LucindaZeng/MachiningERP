# services/api 本地开发环境变量。复制为 services/api/.env 后修改；.env 已被 .gitignore 忽略。
#
# 这份是 **API 进程真正读取的全集**——服务端所有配置都从 process.env 取，
# 没有任何主机名硬编码在代码里。infra/.env.example 是给 docker compose 用的那一份，
# 两边的库/对象存储口令必须一致，否则 API 连得上库、却拿不到文件。

# --- 数据库 ---
DATABASE_URL=postgresql://erp:erp_dev_password@localhost:5432/machining_erp?schema=public

# --- API ---
API_PORT=3000
API_GLOBAL_PREFIX=api/v1
NODE_ENV=development

# --- 认证 ---
# NODE_ENV=production 时长度不足 32 会直接启动失败，这是有意的
JWT_SECRET=change-me-in-production-at-least-32-characters
JWT_EXPIRES_IN=8h

LOGIN_CAPTCHA_THRESHOLD=3
LOGIN_LOCK_THRESHOLD=8
LOGIN_LOCK_MINUTES=30
CAPTCHA_TTL_SECONDS=120

# --- 对象存储（MinIO / S3）---
# ⚠️ 两个端点不是一个，这是本项目最容易踩的坑：
#   S3_ENDPOINT         浏览器可达的地址（本机 localhost:9000，生产是对外域名）
#   S3_PREVIEW_ENDPOINT kkFileView **容器**可达的地址（compose 内走服务名）
# 预签名 URL 是交给 kkFileView 去取文件的；签在 localhost 上，
# 容器里的 localhost 是它自己，必然取不到。
S3_ENDPOINT=http://localhost:9000
S3_PREVIEW_ENDPOINT=http://minio:9000
S3_BUCKET=machining-erp
S3_REGION=us-east-1
# 不填则回落到 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD，再回落到 erp / erp_dev_password
S3_ACCESS_KEY_ID=erp
S3_SECRET_ACCESS_KEY=erp_dev_password

# 单文件上传上限（字节），默认 50MB
UPLOAD_MAX_BYTES=52428800

# --- 在线预览（kkFileView）---
# 本地直连 8012；生产经 Nginx 反代改为 https://<域名>/preview
KK_PREVIEW_BASE_URL=http://localhost:8012
# 预签名有效期（秒），硬上限 300，超出自动截断为 300
KK_PREVIEW_TTL_SECONDS=180

# --- 首个管理员（仅 prisma db seed 使用）---
SEED_ADMIN_ACCOUNT=admin
SEED_ADMIN_PASSWORD=Wfx@2026
