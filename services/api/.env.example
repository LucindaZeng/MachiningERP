# services/api 本地开发环境变量。复制为 services/api/.env 后修改；.env 已被 .gitignore 忽略。
# 完整清单见 infra/.env.example。

DATABASE_URL=postgresql://erp:erp_dev_password@localhost:5432/machining_erp?schema=public

API_PORT=3000
API_GLOBAL_PREFIX=api/v1
NODE_ENV=development

JWT_SECRET=change-me-in-production-at-least-32-characters
JWT_EXPIRES_IN=8h

LOGIN_CAPTCHA_THRESHOLD=3
LOGIN_LOCK_THRESHOLD=8
LOGIN_LOCK_MINUTES=30
CAPTCHA_TTL_SECONDS=120

SEED_ADMIN_ACCOUNT=admin
SEED_ADMIN_PASSWORD=Wfx@2026
