// MachiningERP 数据模型 —— M0 平台底座 + auth/identity/org 切片。
//
// 约定（docs/development/development-guide.md 第 4 节）：
//   * 表名 snake_case 复数，模型名 PascalCase；
//   * 所有业务表必备 created_at/by、updated_at/by、version（乐观锁）；
//   * 单据类表额外必备 doc_no、status 状态机，并把每次状态迁移写入 doc_timelines；
//   * 金额一律整数最小货币单位（BigInt）+ 币种字段；数量一律 Decimal，禁止 Float。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 枚举
// ============================================================

/// 账号分域（ADR-0004）：内部员工与门户账号不共享会话
enum LoginAudience {
  INTERNAL
  PORTAL

  @@map("login_audience")
}

/// 在职状态：离职后**用户名**释放可被他人再次登记，唯一编码永不释放
enum EmploymentStatus {
  ACTIVE
  LEFT

  @@map("employment_status")
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum RequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED

  @@map("request_status")
}

enum PasswordResetStatus {
  SUBMITTED
  RESET_DONE
  REJECTED

  @@map("password_reset_status")
}

/// 单据编号重置策略
enum NumberResetPolicy {
  NONE
  DAILY
  MONTHLY
  YEARLY

  @@map("number_reset_policy")
}

enum TimelineNodeStatus {
  PENDING
  IN_PROGRESS
  DONE
  ABNORMAL

  @@map("timeline_node_status")
}

enum ApprovalTaskStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED

  @@map("approval_task_status")
}

enum ApprovalInstanceStatus {
  RUNNING
  APPROVED
  REJECTED
  CANCELLED

  @@map("approval_instance_status")
}

enum DataScopeType {
  ALL
  DEPARTMENT
  DEPARTMENT_AND_BELOW
  SELF
  ASSIGNED_CUSTOMERS

  @@map("data_scope_type")
}

// ============================================================
// org —— 组织与部门（13 部门口径，命名以 example/基础资料 为准）
// ============================================================

model Department {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique @db.VarChar(32)
  name      String  @db.VarChar(64)
  shortName String? @map("short_name") @db.VarChar(32)
  parentId  String? @map("parent_id") @db.Uuid
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")
  users    User[]

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.VarChar(32)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.VarChar(32)
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(0)

  @@index([parentId])
  @@map("departments")
}

// ============================================================
// identity —— 用户、唯一编码、角色权限、数据权限
// ============================================================

/// 已发放的唯一编码。**只增不删**：即使用户被清理，编码也不回收，
/// 保证历史单据与审计永远能解析到原始责任人（业务规格「用户名释放规则」）。
model IssuedUserCode {
  code     String   @id @db.VarChar(32)
  issuedAt DateTime @default(now()) @map("issued_at")
  /// 发放来源：ACCOUNT_REQUEST / SEED / MIGRATION
  source   String   @default("ACCOUNT_REQUEST") @db.VarChar(32)
  note     String?  @db.VarChar(255)

  @@map("issued_user_codes")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  /// 唯一编码：注册时生成，终身不变、永不复用；所有单据与审计引用本字段
  userCode String @unique @map("user_code") @db.VarChar(32)

  /// 登录用户名。离职释放后置空（NULL），从而允许新员工登记同一个用户名。
  account  String?       @db.VarChar(32)
  audience LoginAudience @default(INTERNAL)

  /// 离职前使用过的用户名，仅用于「该用户名原由某某使用」的提示与审计
  formerAccount     String?   @map("former_account") @db.VarChar(32)
  accountReleasedAt DateTime? @map("account_released_at")

  displayName  String  @map("display_name") @db.VarChar(64)
  departmentId String? @map("department_id") @db.Uuid
  contact      String? @db.VarChar(64)
  email        String? @db.VarChar(128)

  passwordHash String @map("password_hash") @db.VarChar(255)

  status           UserStatus       @default(ACTIVE)
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  leftAt           DateTime?        @map("left_at")
  lastLoginAt      DateTime?        @map("last_login_at")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles      UserRole[]
  dataScopes DataScope[]
  sessions   AuthSession[]

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.VarChar(32)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.VarChar(32)
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(0)

  /// 同一账号域内在用的用户名唯一；NULL（已释放）在 Postgres 中不参与唯一性判定
  @@unique([audience, account])
  @@index([departmentId])
  @@index([formerAccount])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(48)
  name        String  @db.VarChar(64)
  description String? @db.VarChar(255)
  /// 系统内置角色不可删除
  isSystem    Boolean @default(false) @map("is_system")

  permissions RolePermission[]
  users       UserRole[]
  dataScopes  DataScope[]

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.VarChar(32)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.VarChar(32)
  version   Int      @default(0)

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(64)
  name        String  @db.VarChar(64)
  category    String  @db.VarChar(32)
  description String? @db.VarChar(255)

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by") @db.VarChar(32)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  grantedAt DateTime @default(now()) @map("granted_at")
  grantedBy String?  @map("granted_by") @db.VarChar(32)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// 数据权限：查询层强制注入（api-conventions.md「认证与权限」）
model DataScope {
  id       String        @id @default(uuid()) @db.Uuid
  userId   String?       @map("user_id") @db.Uuid
  roleId   String?       @map("role_id") @db.Uuid
  resource String        @db.VarChar(48)
  type     DataScopeType
  /// 具体范围值（部门编码、客户编号数组等）
  values   Json?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role? @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, resource])
  @@index([roleId, resource])
  @@map("data_scopes")
}

// ============================================================
// auth —— 会话、登录风控、账户申请、密码重置
// ============================================================

model AuthSession {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  /// JWT jti，注销后写 revokedAt，实现服务端可撤销
  tokenId   String        @unique @map("token_id") @db.VarChar(64)
  audience  LoginAudience
  issuedAt  DateTime      @default(now()) @map("issued_at")
  expiresAt DateTime      @map("expires_at")
  revokedAt DateTime?     @map("revoked_at")
  ip        String?       @db.VarChar(64)
  userAgent String?       @map("user_agent") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

/// 登录失败计数：连续失败 3 次强制图形验证码，8 次临时锁定
model LoginAttempt {
  id           String        @id @default(uuid()) @db.Uuid
  audience     LoginAudience
  account      String        @db.VarChar(32)
  failureCount Int           @default(0) @map("failure_count")
  lastFailedAt DateTime?     @map("last_failed_at")
  lockedUntil  DateTime?     @map("locked_until")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([audience, account])
  @@map("login_attempts")
}

model CaptchaChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  /// 大小写不敏感比较，存归一化后的大写文本
  code       String    @db.VarChar(16)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("captcha_challenges")
}

/// 登录页「申请账户」：姓名、部门、用户名、密码；IT 审批后开通
model AccountRequest {
  id        String @id @default(uuid()) @db.Uuid
  requestNo String @unique @map("request_no") @db.VarChar(32)

  employeeName String  @map("employee_name") @db.VarChar(64)
  department   String  @db.VarChar(64)
  departmentId String? @map("department_id") @db.Uuid
  account      String  @db.VarChar(32)
  passwordHash String  @map("password_hash") @db.VarChar(255)
  contact      String? @db.VarChar(64)
  reason       String? @db.VarChar(500)

  /// 提交那一刻即发放的唯一编码，审批通过后原样落到 users.user_code
  userCode   String  @unique @map("user_code") @db.VarChar(32)
  /// 该用户名此前的使用人（离职释放场景）
  reusedFrom String? @map("reused_from") @db.VarChar(128)

  status       RequestStatus @default(SUBMITTED)
  submittedAt  DateTime      @default(now()) @map("submitted_at")
  decidedAt    DateTime?     @map("decided_at")
  decidedBy    String?       @map("decided_by") @db.VarChar(32)
  rejectReason String?       @map("reject_reason") @db.VarChar(500)
  approvedUser String?       @map("approved_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(0)

  @@index([status])
  @@index([account])
  @@map("account_requests")
}

/// 忘记密码 = 派单给 IT 系统管理员重置（不做邮箱/短信自助找回）
model PasswordResetRequest {
  id        String @id @default(uuid()) @db.Uuid
  requestNo String @unique @map("request_no") @db.VarChar(32)

  audience      LoginAudience
  account       String        @db.VarChar(32)
  applicantName String        @map("applicant_name") @db.VarChar(64)
  department    String        @db.VarChar(64)
  contact       String        @db.VarChar(64)
  reason        String?       @db.VarChar(500)

  status      PasswordResetStatus @default(SUBMITTED)
  submittedAt DateTime            @default(now()) @map("submitted_at")
  handledAt   DateTime?           @map("handled_at")
  handledBy   String?             @map("handled_by") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(0)

  @@index([status])
  @@index([audience, account])
  @@map("password_reset_requests")
}

// ============================================================
// platform —— 编号、审计、节点计时、领域事件、幂等、审批流、通知
// ============================================================

model DocNumberRule {
  id           String            @id @default(uuid()) @db.Uuid
  docType      String            @unique @map("doc_type") @db.VarChar(32)
  prefix       String            @db.VarChar(16)
  /// 日期段格式：'' | yyyy | yyyyMM | yyyyMMdd
  datePattern  String            @default("yyyyMMdd") @map("date_pattern") @db.VarChar(16)
  padding      Int               @default(4)
  resetPolicy  NumberResetPolicy @default(DAILY) @map("reset_policy")
  separator    String            @default("") @db.VarChar(4)
  description  String?           @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("doc_number_rules")
}

model DocNumberSequence {
  id        String @id @default(uuid()) @db.Uuid
  docType   String @map("doc_type") @db.VarChar(32)
  /// 重置周期键：NONE 用 '-'，DAILY 用 yyyyMMdd，以此类推
  periodKey String @map("period_key") @db.VarChar(16)
  lastValue Int    @default(0) @map("last_value")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([docType, periodKey])
  @@map("doc_number_sequences")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  /// 责任人一律记唯一编码，不记用户名
  actorUserCode String?  @map("actor_user_code") @db.VarChar(32)
  action        String   @db.VarChar(64)
  entityType    String   @map("entity_type") @db.VarChar(64)
  entityId      String?  @map("entity_id") @db.VarChar(64)
  before        Json?
  after         Json?
  ip            String?  @db.VarChar(64)
  traceId       String?  @map("trace_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserCode])
  @@index([createdAt])
  @@map("audit_logs")
}

/// 单据状态迁移与节点耗时（api-conventions.md「审计与计时」）
model DocTimeline {
  id            String             @id @default(uuid()) @db.Uuid
  docType       String             @map("doc_type") @db.VarChar(32)
  docId         String             @map("doc_id") @db.VarChar(64)
  node          String             @db.VarChar(64)
  sequence      Int                @default(0)
  status        TimelineNodeStatus @default(IN_PROGRESS)
  enteredAt     DateTime           @default(now()) @map("entered_at")
  leftAt        DateTime?          @map("left_at")
  durationMs    BigInt?            @map("duration_ms")
  ownerUserCode String?            @map("owner_user_code") @db.VarChar(32)
  ownerDept     String?            @map("owner_dept") @db.VarChar(64)
  remark        String?            @db.VarChar(500)

  @@index([docType, docId])
  @@map("doc_timelines")
}

/// 领域事件出箱表：预警中心、节点计时、BI 均以事件为事实来源
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique @map("event_id") @db.VarChar(64)
  name        String    @db.VarChar(64)
  payload     Json
  occurredAt  DateTime  @default(now()) @map("occurred_at")
  traceId     String?   @map("trace_id") @db.VarChar(64)
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.VarChar(500)

  @@index([publishedAt])
  @@index([name])
  @@map("outbox_events")
}

/// POST 建单据的幂等记录（api-conventions.md「写操作幂等」）
model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  scope        String   @db.VarChar(64)
  key          String   @db.VarChar(128)
  requestHash  String   @map("request_hash") @db.VarChar(64)
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([scope, key])
  @@map("idempotency_records")
}

model ApprovalFlow {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(48)
  name        String  @db.VarChar(64)
  docType     String  @map("doc_type") @db.VarChar(32)
  description String? @db.VarChar(255)
  isActive    Boolean @default(true) @map("is_active")

  steps     ApprovalFlowStep[]
  instances ApprovalInstance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(0)

  @@map("approval_flows")
}

model ApprovalFlowStep {
  id       String @id @default(uuid()) @db.Uuid
  flowId   String @map("flow_id") @db.Uuid
  sequence Int
  name     String @db.VarChar(64)
  /// 审批角色编码，例如 SALES_MANAGER / FINANCE / GM_OFFICE
  roleCode String @map("role_code") @db.VarChar(48)
  /// SLA 时限（小时），超时进入预警升级
  slaHours Int?   @map("sla_hours")
  /// 条件表达式（留空表示必经节点），例如备料订单固定经总经办
  condition Json?

  flow  ApprovalFlow   @relation(fields: [flowId], references: [id], onDelete: Cascade)
  tasks ApprovalTask[]

  @@unique([flowId, sequence])
  @@map("approval_flow_steps")
}

model ApprovalInstance {
  id       String                 @id @default(uuid()) @db.Uuid
  flowId   String                 @map("flow_id") @db.Uuid
  docType  String                 @map("doc_type") @db.VarChar(32)
  docId    String                 @map("doc_id") @db.VarChar(64)
  docNo    String?                @map("doc_no") @db.VarChar(32)
  status   ApprovalInstanceStatus @default(RUNNING)
  /// T0：审批链计时起点
  startedAt DateTime              @default(now()) @map("started_at")
  endedAt   DateTime?             @map("ended_at")

  flow  ApprovalFlow   @relation(fields: [flowId], references: [id])
  tasks ApprovalTask[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(0)

  @@index([docType, docId])
  @@map("approval_instances")
}

model ApprovalTask {
  id            String             @id @default(uuid()) @db.Uuid
  instanceId    String             @map("instance_id") @db.Uuid
  stepId        String             @map("step_id") @db.Uuid
  sequence      Int
  status        ApprovalTaskStatus @default(PENDING)
  assigneeRole  String             @map("assignee_role") @db.VarChar(48)
  decidedBy     String?            @map("decided_by") @db.VarChar(32)
  decidedAt     DateTime?          @map("decided_at")
  /// 驳回必须填写理由（报价修改申请等场景为硬校验）
  comment       String?            @db.VarChar(500)
  arrivedAt     DateTime           @default(now()) @map("arrived_at")
  durationMs    BigInt?            @map("duration_ms")

  instance ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  step     ApprovalFlowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([instanceId])
  @@index([status, assigneeRole])
  @@map("approval_tasks")
}

model Notification {
  id                String    @id @default(uuid()) @db.Uuid
  /// 收件人一律用唯一编码
  recipientUserCode String    @map("recipient_user_code") @db.VarChar(32)
  category          String    @db.VarChar(48)
  title             String    @db.VarChar(128)
  body              String?   @db.VarChar(1000)
  link              String?   @db.VarChar(255)
  docType           String?   @map("doc_type") @db.VarChar(32)
  docId             String?   @map("doc_id") @db.VarChar(64)
  readAt            DateTime? @map("read_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([recipientUserCode, readAt])
  @@map("notifications")
}

// ============================================================
// masterdata —— 客户档案（业务部模块 3；下单校验链的第一环）
// ============================================================

/// 国内客户必填税号，国外客户走报关资料口径
enum CustomerRegion {
  DOMESTIC
  OVERSEAS

  @@map("customer_region")
}

enum CustomerStatus {
  /// 报价阶段的新客户：只有公司名、联系人、联系方式
  DRAFT
  /// 已提交完整档案待审
  PENDING
  ACTIVE
  SUSPENDED

  @@map("customer_status")
}

/// 付款条件三选一（业务规格 3.1）
enum PaymentTerm {
  /// ① 预付一定比例、剩余出货前付清
  DEPOSIT_THEN_BALANCE
  /// ② 现金，出货前全部付完
  CASH_BEFORE_SHIPMENT
  /// ③ 票到 30 / 60 / 90 天
  NET_30
  NET_60
  NET_90

  @@map("payment_term")
}

enum InvoiceType {
  /// 普票
  GENERAL
  /// 专票
  SPECIAL

  @@map("invoice_type")
}

enum SettlementMethod {
  CASH
  NOTE

  @@map("settlement_method")
}

model Customer {
  id String @id @default(uuid()) @db.Uuid

  /// 客户编号由平台统一编号规则生成，不可手改
  code      String         @unique @db.VarChar(32)
  name      String         @db.VarChar(128)
  shortName String         @map("short_name") @db.VarChar(64)
  region    CustomerRegion
  country   String         @db.VarChar(64)

  /// 报关资料需要的英文名称与地址（模块 10）
  englishName    String? @map("english_name") @db.VarChar(128)
  englishAddress String? @map("english_address") @db.VarChar(255)

  ownerName  String  @map("owner_name") @db.VarChar(64)
  ownerPhone String  @map("owner_phone") @db.VarChar(64)
  ownerEmail String? @map("owner_email") @db.VarChar(128)

  /// 负责对接的业务人员：存唯一编码，驱动工作台数据权限
  salesUserCode String? @map("sales_user_code") @db.VarChar(32)

  /// 国内客户必填（服务层硬校验）
  taxNo          String? @map("tax_no") @db.VarChar(64)
  invoiceAddress String  @map("invoice_address") @db.VarChar(255)
  bankAccount    String? @map("bank_account") @db.VarChar(64)
  bankName       String? @map("bank_name") @db.VarChar(128)

  paymentTerm PaymentTerm      @map("payment_term")
  /// 付款条件①的预付比例，按万分比存整数避免浮点（3000 = 30%）
  depositBps  Int?             @map("deposit_bps")
  invoiceType InvoiceType      @map("invoice_type")
  settlement  SettlementMethod
  currency    String           @default("CNY") @db.VarChar(8)
  tradeTerm   String?          @map("trade_term") @db.VarChar(64)
  level       String?          @db.VarChar(32)

  status     CustomerStatus @default(DRAFT)
  approvedBy String?        @map("approved_by") @db.VarChar(32)
  approvedAt DateTime?      @map("approved_at")

  /// 财务维护字段：业务角色只读，金额一律整数最小货币单位
  creditLimitMinor    BigInt @default(0) @map("credit_limit_minor")
  creditUsedMinor     BigInt @default(0) @map("credit_used_minor")
  overdueAmountMinor  BigInt @default(0) @map("overdue_amount_minor")
  arDays              Int    @default(0) @map("ar_days")

  addresses       CustomerDeliveryAddress[]
  changeRequests  CustomerChangeRequest[]

  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.VarChar(32)
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.VarChar(32)
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(0)

  @@index([salesUserCode])
  @@index([status])
  @@map("customers")
}

/// 送货地址：最多 5 个，其中恰好一个为默认（服务层硬校验）
model CustomerDeliveryAddress {
  id         String  @id @default(uuid()) @db.Uuid
  customerId String  @map("customer_id") @db.Uuid
  label      String  @db.VarChar(64)
  receiver   String  @db.VarChar(64)
  phone      String  @db.VarChar(64)
  address    String  @db.VarChar(255)
  isDefault  Boolean @default(false) @map("is_default")
  sortOrder  Int     @default(0) @map("sort_order")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("customer_delivery_addresses")
}

/// 敏感字段（银行账号、付款条件等）变更申请：留痕并按权限审批后才生效
model CustomerChangeRequest {
  id         String        @id @default(uuid()) @db.Uuid
  requestNo  String        @unique @map("request_no") @db.VarChar(32)
  customerId String        @map("customer_id") @db.Uuid
  /// 变更字段的前后值快照，键为字段名
  changes    Json
  reason     String        @db.VarChar(500)
  status     RequestStatus @default(SUBMITTED)

  submittedBy  String    @map("submitted_by") @db.VarChar(32)
  submittedAt  DateTime  @default(now()) @map("submitted_at")
  decidedBy    String?   @map("decided_by") @db.VarChar(32)
  decidedAt    DateTime? @map("decided_at")
  rejectReason String?   @map("reject_reason") @db.VarChar(500)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(0)

  @@index([customerId, status])
  @@map("customer_change_requests")
}

// ============================================================
// quotation —— 报价管理（业务部模块 2）
// 成本分析格式以 example/成本分析/CNC成本分析.xls 为准，
// 报价单格式以 example/报价单模板/ 两份文件为准。
// ============================================================

enum DrawingSource {
  /// 报价环节上传，自动流转报价工程师（核价）与工程部（建 BOM）
  QUOTATION
  ECN
  ENGINEERING

  @@map("drawing_source")
}

enum CostAnalysisStatus {
  DRAFT
  /// 核价完成，可据此生成报价单
  COMPLETED
  /// 报价审核通过后锁版；改价一律生成新版本
  LOCKED

  @@map("cost_analysis_status")
}

enum QuotationStatus {
  DRAFT
  IN_REVIEW
  EFFECTIVE
  WON
  LOST
  EXPIRED

  @@map("quotation_status")
}

enum QuoteChangeStatus {
  SUBMITTED
  /// 报价工程师重核成本分析并出新版本
  REVISED
  /// 驳回必须填理由
  REJECTED

  @@map("quote_change_status")
}

/// 原材料价格表：由授权岗位维护，成本分析带出材料单价并留痕
model MaterialPrice {
  id       String  @id @default(uuid()) @db.Uuid
  /// 材质，如 AL6061-T6
  material String  @db.VarChar(64)
  /// 规格/形态，如 板料 / 型材 / 棒料
  shape    String  @db.VarChar(32)
  /// 单价，整数最小货币单位；单位为「元/KG」
  unitPriceMinor BigInt @map("unit_price_minor")
  currency String  @default("CNY") @db.VarChar(8)
  /// 生效日期，取价时按「不晚于报价日期的最新一条」
  effectiveFrom DateTime @map("effective_from")
  source   String  @db.VarChar(64)
  remark   String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.VarChar(32)
  updatedAt DateTime @updatedAt @map("updated_at")
  version   Int      @default(0)

  @@index([material, shape, effectiveFrom])
  @@map("material_prices")
}

/// 当日汇率表：国外报价按当日汇率换算，并在报价版本上留快照
model ExchangeRate {
  id       String   @id @default(uuid()) @db.Uuid
  base     String   @db.VarChar(8)
  quote    String   @db.VarChar(8)
  /// 汇率按百万分比存整数（7.1234 → 7123400），避免浮点
  rateMicros BigInt @map("rate_micros")
  quotedOn DateTime @map("quoted_on")
  source   String   @default("MANUAL") @db.VarChar(32)

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.VarChar(32)

  @@unique([base, quote, quotedOn])
  @@map("exchange_rates")
}

/// 图纸库：报价环节上传一次，报价工程师与工程部两处引用，版本递增
model Drawing {
  id         String  @id @default(uuid()) @db.Uuid
  /// 名称图号
  drawingNo  String  @map("drawing_no") @db.VarChar(64)
  customerId String? @map("customer_id") @db.Uuid
  title      String? @db.VarChar(128)

  versions DrawingVersion[]

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.VarChar(32)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([drawingNo, customerId])
  @@index([customerId])
  @@map("drawings")
}

model DrawingVersion {
  id        String        @id @default(uuid()) @db.Uuid
  drawingId String        @map("drawing_id") @db.Uuid
  /// 版本号，如 REV A / V2
  revision  String        @db.VarChar(32)
  sequence  Int
  source    DrawingSource @default(QUOTATION)
  /// 对象存储 key，下载走 docgen 的受控预签名 URL
  fileKey   String        @map("file_key") @db.VarChar(255)
  fileName  String        @map("file_name") @db.VarChar(255)
  fileSize  Int           @map("file_size")
  uploadedBy String       @map("uploaded_by") @db.VarChar(32)
  uploadedAt DateTime     @default(now()) @map("uploaded_at")

  drawing Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  @@unique([drawingId, sequence])
  @@index([drawingId])
  @@map("drawing_versions")
}

/// 成本分析表（仅报价工程师可建/改）
model CostAnalysis {
  id        String @id @default(uuid()) @db.Uuid
  docNo     String @unique @map("doc_no") @db.VarChar(32)
  /// 同一份核价的版本链：改价重核生成新版本，旧版本保留
  version   Int    @default(1)
  rootId    String? @map("root_id") @db.Uuid

  customerId   String @map("customer_id") @db.Uuid
  productModel String @map("product_model") @db.VarChar(128)

  /// 损耗率与管理费利润率按万分比存整数（500 = 5%），默认各 5%、可调
  lossBps      Int @default(500) @map("loss_bps")
  overheadBps  Int @default(500) @map("overhead_bps")
  /// 增值税率，默认 13%
  vatBps       Int @default(1300) @map("vat_bps")
  currency     String @default("CNY") @db.VarChar(8)

  /// 工艺成本列的列定义（可自由加减），顺序即展示顺序
  processColumns Json @map("process_columns")

  status     CostAnalysisStatus @default(DRAFT)
  preparedBy String             @map("prepared_by") @db.VarChar(32)
  completedAt DateTime?         @map("completed_at")

  lines      CostAnalysisLine[]
  quotations Quotation[]

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.VarChar(32)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.VarChar(32)
  versionLock Int    @default(0) @map("version_lock")

  @@index([customerId])
  @@index([rootId])
  @@map("cost_analyses")
}

/// 成本分析明细：每个零件一行，列口径与 CNC成本分析.xls 逐列对应
model CostAnalysisLine {
  id             String @id @default(uuid()) @db.Uuid
  costAnalysisId String @map("cost_analysis_id") @db.Uuid
  sequence       Int

  /// 毛料类型：板料 / 型材 / 棒料 等
  blankType   String  @map("blank_type") @db.VarChar(32)
  drawingNo   String  @map("drawing_no") @db.VarChar(128)
  drawingVersionId String? @map("drawing_version_id") @db.Uuid
  /// 规格型号（尺寸），如 115*106*19.04
  spec        String  @db.VarChar(64)
  revision    String? @db.VarChar(32)
  quantity    Decimal @default(1) @db.Decimal(18, 6)
  material    String  @db.VarChar(64)

  /// 重量一律 Decimal，禁止浮点
  estimatedWeightKg Decimal @map("estimated_weight_kg") @db.Decimal(18, 6)
  netWeightKg       Decimal @map("net_weight_kg") @db.Decimal(18, 6)
  scrapWeightKg     Decimal @map("scrap_weight_kg") @db.Decimal(18, 6)

  /// 单价一律整数最小货币单位
  scrapUnitPriceMinor    BigInt @default(0) @map("scrap_unit_price_minor")
  materialUnitPriceMinor BigInt @map("material_unit_price_minor")
  /// 材料单价是否手工改过（从价格表带出后可改，须留痕）
  materialPriceOverridden Boolean @default(false) @map("material_price_overridden")
  materialPriceSourceId   String? @map("material_price_source_id") @db.Uuid

  /// 机加方式（CNC / 车床…）与加工时间（分钟）、加工金额
  machiningMethod   String @map("machining_method") @db.VarChar(32)
  machiningMinutes  Decimal @map("machining_minutes") @db.Decimal(18, 6)
  machiningCostMinor BigInt @map("machining_cost_minor")

  /// 各工艺列金额，键为 processColumns 里的列 key
  processCosts Json @map("process_costs")

  remark String? @db.VarChar(255)

  costAnalysis CostAnalysis @relation(fields: [costAnalysisId], references: [id], onDelete: Cascade)

  @@unique([costAnalysisId, sequence])
  @@index([costAnalysisId])
  @@map("cost_analysis_lines")
}

/// 报价单。强制关联成本分析与图纸，审核通过后锁版
model Quotation {
  id      String @id @default(uuid()) @db.Uuid
  docNo   String @unique @map("doc_no") @db.VarChar(32)
  version Int    @default(1)
  rootId  String? @map("root_id") @db.Uuid

  customerId String @map("customer_id") @db.Uuid
  /// 硬校验：无成本分析不能创建、不能提交审核
  costAnalysisId String @map("cost_analysis_id") @db.Uuid

  /// 国内 / 国外两套模板
  template String @default("DOMESTIC") @db.VarChar(16)
  currency String @default("CNY") @db.VarChar(8)
  /// 国外报价的当日汇率快照（百万分比整数），历史数据不随汇率表变动
  fxRateMicros BigInt? @map("fx_rate_micros")
  fxQuotedOn   DateTime? @map("fx_quoted_on")

  /// 模具费单列，**不摊入单件价**
  moldFeeMinor BigInt @default(0) @map("mold_fee_minor")

  /// 报价单条款（国内模板：代工方式/付款方式/允许报废率/废料退还/有效期限）
  terms Json?

  status     QuotationStatus @default(DRAFT)
  validUntil DateTime?       @map("valid_until")
  submittedBy String?        @map("submitted_by") @db.VarChar(32)
  submittedAt DateTime?      @map("submitted_at")
  approvedBy  String?        @map("approved_by") @db.VarChar(32)
  approvedAt  DateTime?      @map("approved_at")
  rejectReason String?       @map("reject_reason") @db.VarChar(500)

  costAnalysis   CostAnalysis          @relation(fields: [costAnalysisId], references: [id])
  items          QuotationItem[]
  changeRequests QuoteChangeRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.VarChar(32)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.VarChar(32)
  versionLock Int    @default(0) @map("version_lock")

  @@index([customerId, status])
  @@index([rootId])
  @@map("quotations")
}

model QuotationItem {
  id          String @id @default(uuid()) @db.Uuid
  quotationId String @map("quotation_id") @db.Uuid
  sequence    Int

  /// 产品名称 / 名称图号 / 版本 / 材质 / 表面处理，对应两份模板的表头
  productName String  @map("product_name") @db.VarChar(128)
  drawingNo   String  @map("drawing_no") @db.VarChar(128)
  drawingVersionId String? @map("drawing_version_id") @db.Uuid
  revision    String? @db.VarChar(32)
  material    String? @db.VarChar(64)
  finishing   String? @db.VarChar(64)
  process     String? @db.VarChar(64)
  /// 关联的成本分析行，用于「低于成本价」比对
  costAnalysisLineId String? @map("cost_analysis_line_id") @db.Uuid
  remark      String? @db.VarChar(255)

  tiers QuotationTier[]

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, sequence])
  @@index([quotationId])
  @@map("quotation_items")
}

/// 阶梯价：按数量段报价；非阶梯即只有一档
model QuotationTier {
  id     String @id @default(uuid()) @db.Uuid
  itemId String @map("item_id") @db.Uuid
  /// 起订量，如 10 / 100 / 1000
  minQuantity Decimal @map("min_quantity") @db.Decimal(18, 6)
  /// 业务员填入的最终报价（整数最小货币单位）
  unitPriceMinor BigInt @map("unit_price_minor")
  /// 该档对应的单件成本快照，用于「低于成本价」拦截与毛利回溯
  unitCostMinor  BigInt @map("unit_cost_minor")
  label String? @db.VarChar(32)

  item QuotationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, minQuantity])
  @@index([itemId])
  @@map("quotation_tiers")
}

/// 报价单修改申请：业务提改后价格 → 报价工程师改成本分析或驳回（驳回必填理由）
model QuoteChangeRequest {
  id          String @id @default(uuid()) @db.Uuid
  requestNo   String @unique @map("request_no") @db.VarChar(32)
  quotationId String @map("quotation_id") @db.Uuid

  /// 业务希望改到的目标价（按产品行给出）
  targetPrices Json   @map("target_prices")
  reason       String @db.VarChar(500)

  status       QuoteChangeStatus @default(SUBMITTED)
  submittedBy  String            @map("submitted_by") @db.VarChar(32)
  submittedAt  DateTime          @default(now()) @map("submitted_at")
  handledBy    String?           @map("handled_by") @db.VarChar(32)
  handledAt    DateTime?         @map("handled_at")
  /// 驳回理由必填，且要回到业务员的工作台通知里
  rejectReason String?           @map("reject_reason") @db.VarChar(500)
  /// 重核后产生的新成本分析版本
  revisedCostAnalysisId String?  @map("revised_cost_analysis_id") @db.Uuid

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  versionLock Int    @default(0) @map("version_lock")

  @@index([quotationId, status])
  @@map("quote_change_requests")
}

// ───────────────────────────── 公司基础资料（example/基础资料工艺车间仓库ByCoder.xls）
// 业务部模块直接引用，不在业务部内另建平行表（业务规格「主数据引用」）。

/// 工艺性质：厂内自制 / 委外加工
enum ProcessNature {
  IN_HOUSE
  OUTSOURCED

  @@map("process_nature")
}

/// 工艺基础表。成本分析的可加减工艺列、订单追踪的节点、报价工艺组合匹配都从这里取值。
model ProcessDefinition {
  /// 工艺编号（10=CNC、11=车床、12=切料…），来源 xls，不重排
  code           String        @id @db.VarChar(8)
  name           String        @db.VarChar(64)
  nature         ProcessNature
  /// 生产单位（一部车间/车床车间/后工序车间/委外表处…）
  productionUnit String        @map("production_unit") @db.VarChar(32)
  /// 责任部门，订单追踪节点按此显示
  department     String?       @db.VarChar(32)
  /// 展示与默认工艺路线的排序
  sequence       Int
  active         Boolean       @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([nature, sequence])
  @@map("process_definitions")
}

/// 仓库表。备料完工入成品仓 100，样品入样品仓 400。
model WarehouseDefinition {
  code        String  @id @db.VarChar(8)
  name        String  @db.VarChar(64)
  category    String  @db.VarChar(32)
  /// 是否纳入 LRP 计算
  lrpIncluded Boolean @default(false) @map("lrp_included")
  stockType   String? @map("stock_type") @db.VarChar(32)
  remark      String? @db.VarChar(255)
  active      Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("warehouse_definitions")
}

/// 车间表，订单追踪节点的责任车间由此对应。
model WorkshopDefinition {
  code     String  @id @db.VarChar(8)
  name     String  @db.VarChar(64)
  /// 与工艺表的 productionUnit 对齐（一部车间/车床车间/后工序车间…）
  unitName String  @map("unit_name") @db.VarChar(32)
  remark   String? @db.VarChar(255)
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("workshop_definitions")
}

// ───────────────────────────── contract-order（订单管理，业务规格第 4 章）

/// 五种下单动作里的四种订单类型；「订单修改申请」是独立单据而非订单类型。
enum SalesOrderType {
  /// 正常业务订单（批量）
  FORMAL
  /// 样品订单：无 BOM、无成品品号，入样品仓 400
  SAMPLE
  /// 模具订单：只填要求完成时间，不设完成/未完成状态
  MOLD
  /// 备料订单：无交货义务，全部完工入库即完成，须总经办批准
  STOCK_PREP

  @@map("sales_order_type")
}

/// 收费方式。正式订单强制收费；免费/部分收费须补齐费用承担方、预计成本与原因。
enum ChargeMode {
  CHARGED
  FREE
  PARTIAL
  /// 递延至正式订单分摊
  DEFERRED
  /// 押金 / 达量返还
  DEPOSIT
  /// 内部备料，不计客户应收
  INTERNAL

  @@map("charge_mode")
}

/// 订单审核链：业务经理 → 财务 → 跨部门订单评审；备料订单额外经总经办。
enum SalesOrderStatus {
  DRAFT
  /// 待业务经理审核（T0 从提交起算）
  MANAGER_REVIEW
  /// 待财务审核
  FINANCE_REVIEW
  /// 待总经办审批（仅备料订单，无论金额大小）
  GM_REVIEW
  /// 待跨部门订单评审
  CROSS_REVIEW
  APPROVED
  EXECUTING
  COMPLETED
  CLOSED
  REJECTED
  VOID

  @@map("sales_order_status")
}

/// 备料库存的生命周期：生产中 → 已入库可领用 → 已用完
enum StockPrepStatus {
  PRODUCING
  STOCKED
  CONSUMED

  @@map("stock_prep_status")
}

model SalesOrder {
  id        String @id @default(uuid()) @db.Uuid
  docNo     String @unique @map("doc_no") @db.VarChar(32)

  customerId   String         @map("customer_id") @db.Uuid
  orderType    SalesOrderType @map("order_type")
  chargeMode   ChargeMode     @map("charge_mode")

  /// 客户原始订单号与原件附件：模具/正式一律必填，收费样品也必填
  customerPoNo   String? @map("customer_po_no") @db.VarChar(64)
  customerPoFile String? @map("customer_po_file") @db.VarChar(255)

  currency String @default("CNY") @db.VarChar(8)
  /// 税率按万分比整数存，避开浮点
  taxRateBps Int  @default(1300) @map("tax_rate_bps")

  /// 备料订单没有客户交期，改填内部要求完成时间
  internalDueDate DateTime? @map("internal_due_date")

  /// 免费/部分收费时必填的三要素
  costOwner        String? @map("cost_owner") @db.VarChar(64)
  freeReason       String? @map("free_reason") @db.VarChar(255)
  estimatedCostMinor BigInt? @map("estimated_cost_minor")

  status      SalesOrderStatus @default(DRAFT)
  /// 审批链 T0：提交时刻，用于各节点时长统计
  submittedAt DateTime? @map("submitted_at")
  submittedBy String?   @map("submitted_by") @db.VarChar(32)
  approvedAt  DateTime? @map("approved_at")
  rejectReason String?  @map("reject_reason") @db.VarChar(500)

  /// 备料订单专用：完工入库数量，达到订单数量即视为完成
  stockedQty Decimal? @map("stocked_qty") @db.Decimal(18, 6)
  /// 备料库存状态，仅 STOCK_PREP 有值
  stockStatus StockPrepStatus? @map("stock_status")

  lines         SalesOrderLine[]
  changeRequests OrderChangeRequest[]
  /// 本单作为备料单被哪些正式订单领用
  consumptions  StockConsumption[] @relation("StockPrepSource")

  createdBy String?  @map("created_by") @db.VarChar(32)
  updatedBy String?  @map("updated_by") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  versionLock Int    @default(0) @map("version_lock")

  @@index([customerId, orderType, status])
  @@index([status, submittedAt])
  @@map("sales_orders")
}

/// 订单明细行。一张订单可下多项产品，每行独立数量、单价与交期跟踪。
model SalesOrderLine {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  sequence Int

  /// 报价单行来源：环环相扣，必须有生效报价才能下单
  quotationId     String? @map("quotation_id") @db.Uuid
  quotationItemId String? @map("quotation_item_id") @db.Uuid
  costAnalysisId  String? @map("cost_analysis_id") @db.Uuid

  productName String  @map("product_name") @db.VarChar(128)
  drawingNo   String  @map("drawing_no") @db.VarChar(128)
  drawingVersionId String? @map("drawing_version_id") @db.Uuid
  revision    String? @db.VarChar(32)
  /// 10 位物料码：成品 10+客户4+机种4；样品 12+客户4+流水4；模具 19 段
  itemCode    String? @map("item_code") @db.VarChar(16)
  /// BOM 申请：样品单除外，正式单下单前必须已确认
  bomRequestNo String? @map("bom_request_no") @db.VarChar(32)

  quantity  Decimal @db.Decimal(18, 6)
  /// 客户原始单价
  unitPriceMinor BigInt @map("unit_price_minor")
  /// 客户交期；备料订单为空
  deliveryDate DateTime? @map("delivery_date")
  remark    String? @db.VarChar(255)

  order        SalesOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  consumptions StockConsumption[]
  trackingNodes OrderTrackingNode[]

  @@unique([orderId, sequence])
  @@index([drawingNo])
  @@map("sales_order_lines")
}

/// 正式订单领用备料库存的履历：剩余数量与被哪张正式订单消耗全程可查。
model StockConsumption {
  id String @id @default(uuid()) @db.Uuid

  /// 被领用的备料订单
  stockOrderId String @map("stock_order_id") @db.Uuid
  /// 领用方的正式订单行
  orderLineId  String @map("order_line_id") @db.Uuid

  consumedQty Decimal @map("consumed_qty") @db.Decimal(18, 6)
  /// 快照：备料单件成本与本单新产单件成本，加权结果不再随后续改动漂移
  stockUnitCostMinor   BigInt @map("stock_unit_cost_minor")
  produceQty           Decimal @map("produce_qty") @db.Decimal(18, 6)
  produceUnitCostMinor BigInt @map("produce_unit_cost_minor")
  /// 加权平均单件成本 =（备料成本×领用数 + 新产成本×新产数）÷ 订单数量
  blendedUnitCostMinor BigInt @map("blended_unit_cost_minor")
  currency             String @default("CNY") @db.VarChar(8)

  stockOrder SalesOrder     @relation("StockPrepSource", fields: [stockOrderId], references: [id])
  orderLine  SalesOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  createdBy String?  @map("created_by") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([stockOrderId])
  @@unique([orderLineId, stockOrderId])
  @@map("stock_consumptions")
}

/// 订单修改申请：只改数量、交期等订单信息；价格与下单产品锁定。
enum OrderChangeType {
  QUANTITY
  DELIVERY
  SHIP_TO
  PACKING
  CANCEL

  @@map("order_change_type")
}

enum OrderChangeStatus {
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED

  @@map("order_change_status")
}

model OrderChangeRequest {
  id        String @id @default(uuid()) @db.Uuid
  requestNo String @unique @map("request_no") @db.VarChar(32)
  orderId   String @map("order_id") @db.Uuid
  /// 针对某一行；为空表示整单
  orderLineId String? @map("order_line_id") @db.Uuid

  changeType OrderChangeType @map("change_type")
  origin     String          @db.VarChar(16)
  urgent     Boolean         @default(false)

  beforeValue String @map("before_value") @db.VarChar(255)
  afterValue  String @map("after_value") @db.VarChar(255)
  reason      String @db.VarChar(500)
  costOwner   String? @map("cost_owner") @db.VarChar(64)

  status      OrderChangeStatus @default(SUBMITTED)
  submittedBy String            @map("submitted_by") @db.VarChar(32)
  submittedAt DateTime          @default(now()) @map("submitted_at")
  handledBy   String?           @map("handled_by") @db.VarChar(32)
  handledAt   DateTime?         @map("handled_at")
  rejectReason String?          @map("reject_reason") @db.VarChar(500)

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  versionLock Int    @default(0) @map("version_lock")

  @@index([orderId, status])
  @@map("order_change_requests")
}

/// 追踪节点状态。一律由事件推导，不接受手工填报。
enum TrackNodeStatus {
  PENDING
  ACTIVE
  DONE
  BLOCKED

  @@map("track_node_status")
}

/// 订单追踪节点。起点是订单评审，节点链按产品工艺路线自动裁剪。
model OrderTrackingNode {
  id          String @id @default(uuid()) @db.Uuid
  orderLineId String @map("order_line_id") @db.Uuid

  sequence Int
  /// 关联工艺基础表；订单评审、PMC 计划这类非工艺节点为空
  processCode String? @map("process_code") @db.VarChar(8)
  node        String  @db.VarChar(64)
  phase       String  @db.VarChar(32)
  department  String  @db.VarChar(32)

  status TrackNodeStatus @default(PENDING)
  /// 进度一律「完成数/工单数」，绝不存百分比
  qtyIn  Decimal? @map("qty_in") @db.Decimal(18, 6)
  qtyOk  Decimal? @map("qty_ok") @db.Decimal(18, 6)
  qtyNg  Decimal? @map("qty_ng") @db.Decimal(18, 6)

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  remark     String?   @db.VarChar(255)

  orderLine SalesOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orderLineId, sequence])
  @@index([status])
  @@map("order_tracking_nodes")
}

// ───────────────────────────── bom-request（BOM 申请，业务规格第 5 章 / ENG-02、ENG-05）

/// 申请用途。样品既不建 BOM 也不建品号，因此没有 sample 这一项。
enum BomProductionType {
  /// 正式量产：建品号 + BOM + 工艺路线
  BATCH
  /// 模具：建模具编号，不建品号（模具不是可售产品）
  MOLD

  @@map("bom_production_type")
}

enum BomRequestStatus {
  DRAFT
  /// 已提交，待工程接收
  SUBMITTED
  /// 工程已接收，建立中
  CLAIMED
  /// 工程退回补料，退回等待时长累计
  RETURNED
  /// BOM 已建立，可下单（程序可能仍未完成）
  BOM_DONE
  /// BOM 与程序均完成
  ALL_DONE
  /// 已据此下单
  ORDERED

  @@map("bom_request_status")
}

/// BOM 申请。图纸由报价环节上传的版本自动带入，**不重复上传**（业务规格第 5 章）。
model BomRequest {
  id    String @id @default(uuid()) @db.Uuid
  docNo String @unique @map("doc_no") @db.VarChar(32)

  customerId String  @map("customer_id") @db.Uuid
  /// 直接引用报价单内的产品：名称图号、版本、材质自动带入
  quotationId     String? @map("quotation_id") @db.Uuid
  quotationItemId String? @map("quotation_item_id") @db.Uuid
  customerPoNo    String? @map("customer_po_no") @db.VarChar(64)

  productName      String @map("product_name") @db.VarChar(128)
  drawingNo        String @map("drawing_no") @db.VarChar(128)
  /// 图纸库版本；来自报价环节，工程与报价共用同一份
  drawingVersionId String? @map("drawing_version_id") @db.Uuid
  drawingVersion   String  @map("drawing_version") @db.VarChar(32)
  material         String  @db.VarChar(64)
  surfaceTreatment String  @map("surface_treatment") @db.VarChar(64)
  inspection       String  @db.VarChar(128)
  packing          String  @db.VarChar(128)

  quantity           Decimal   @db.Decimal(18, 6)
  targetDeliveryDate DateTime? @map("target_delivery_date")

  productionType BomProductionType @map("production_type")
  /// 由样品转量产时回填的样品订单号，用于把试做工时带入首次量产
  fromSampleNo        String? @map("from_sample_no") @db.VarChar(32)
  specialRequirement  String? @map("special_requirement") @db.VarChar(500)

  status BomRequestStatus @default(DRAFT)
  /// 申请人（业务员），完成时通知回这个人
  ownerUserCode String  @map("owner_user_code") @db.VarChar(32)
  submittedAt   DateTime? @map("submitted_at")
  claimedAt     DateTime? @map("claimed_at")
  claimedBy     String?   @map("claimed_by") @db.VarChar(32)
  /// 工程退回累计等待毫秒数；退回重提时累加，用于时效分析
  returnedMs    BigInt    @default(0) @map("returned_ms")
  returnedAt    DateTime? @map("returned_at")
  returnReason  String?   @map("return_reason") @db.VarChar(500)

  /// ENG-05 双状态：**必须分别落库、分别展示**，不得合并成一个「全部工程完成」
  bomReady     Boolean @default(false) @map("bom_ready")
  programReady Boolean @default(false) @map("program_ready")
  bomReadyAt     DateTime? @map("bom_ready_at")
  programReadyAt DateTime? @map("program_ready_at")

  /// 工程建立的编码：BATCH 时是品号，MOLD 时是模具编号
  productCode String? @map("product_code") @db.VarChar(16)

  createdBy String?  @map("created_by") @db.VarChar(32)
  updatedBy String?  @map("updated_by") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  versionLock Int    @default(0) @map("version_lock")

  @@index([customerId, status])
  @@index([status, submittedAt])
  @@index([drawingNo])
  @@map("bom_requests")
}

// ───────────────────────────── shipment（出货管理 + 客户对账单，业务规格第 7 章）

/// 出货单状态。与前端 `ShipmentStatus` 七态一一对应，界面是设计基线。
enum ShipmentStatus {
  /// 已生成发货通知，等待仓库拣配（SHP-01）
  PLANNED
  /// 仓库拣配出库中（SHP-02）
  PICKING
  /// 全检合格并包装完成，T1 从此刻起算（SHP-03）
  PACKED
  /// 已出运发货（SHP-04）；过此闸门需品质放行 + 财务信用双通过
  SHIPPED
  /// 客户已签收（SHP-05）
  SIGNED
  /// 已开票（SHP-06）
  INVOICED
  /// 商业关闭；结案前做尾数数量平衡校验
  CLOSED

  @@map("shipment_status")
}

/// 尾数四路径（V2.4 尾数规则）。除这四种外不存在第五种处置方式。
enum TailPlan {
  /// 返工补交：拆返工子订单，重新核算重复工序成本
  REWORK
  /// 入库待后续订单：占用尾数库存，保留期满转呆滞
  STOCK
  /// 直接入库：客户已确认不再补交
  DIRECT_STOCK
  /// 报废：需品质与财务确认损失归属
  SCRAP

  @@map("tail_plan")
}

/// 销货出运单。一张出货单可包含多项产品，各行关联各自订单行。
model Shipment {
  id    String @id @default(uuid()) @db.Uuid
  docNo String @unique @map("doc_no") @db.VarChar(32)

  orderId    String @map("order_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  /// 收货地址取自客户档案的送货地址，不在出货单上另建地址簿
  deliveryAddressId String? @map("delivery_address_id") @db.Uuid

  currency   String  @default("CNY") @db.VarChar(8)
  carrier    String? @db.VarChar(128)
  trackingNo String? @map("tracking_no") @db.VarChar(64)
  /// 财务开票后回填，供对账单勾稽
  invoiceNo  String? @map("invoice_no") @db.VarChar(32)

  /// 无偿补发：这一票是为某张 RMA 补货的（业务规格第 8 章「补发不另收费」）。
  /// 非空时**不计入对账单的发货列**——补发已经在原发货里收过一次钱了，
  /// 再计一次等于向客户重复收费。
  replacesReturnId String? @map("replaces_return_id") @db.Uuid

  status        ShipmentStatus @default(PLANNED)
  ownerUserCode String         @map("owner_user_code") @db.VarChar(32)

  packedAt   DateTime? @map("packed_at")
  shippedAt  DateTime? @map("shipped_at")
  signedAt   DateTime? @map("signed_at")
  invoicedAt DateTime? @map("invoiced_at")
  closedAt   DateTime? @map("closed_at")

  lines ShipmentLine[]

  createdBy   String?  @map("created_by") @db.VarChar(32)
  updatedBy   String?  @map("updated_by") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  versionLock Int      @default(0) @map("version_lock")

  @@index([customerId, status])
  @@index([orderId])
  @@index([status, shippedAt])
  @@map("shipments")
}

/// 出货明细行。尾数 = 订单数 − 已发数，处置后记录已结清数量供结案平衡校验。
model ShipmentLine {
  id         String @id @default(uuid()) @db.Uuid
  shipmentId String @map("shipment_id") @db.Uuid
  sequence   Int

  /// 关联的订单行；发货后按行回写已发数量与订单状态
  orderLineId String @map("order_line_id") @db.Uuid

  productName String  @map("product_name") @db.VarChar(128)
  drawingNo   String  @map("drawing_no") @db.VarChar(128)
  itemCode    String? @map("item_code") @db.VarChar(16)
  batchNo     String  @map("batch_no") @db.VarChar(64)

  /// 订单需求数 / 全检合格数 / 包装数 / 本次发货数
  orderedQty   Decimal @map("ordered_qty") @db.Decimal(18, 6)
  qualifiedQty Decimal @map("qualified_qty") @db.Decimal(18, 6)
  packedQty    Decimal @map("packed_qty") @db.Decimal(18, 6)
  shippedQty   Decimal @map("shipped_qty") @db.Decimal(18, 6)

  unitPriceMinor BigInt @map("unit_price_minor")

  /// 尾数处置：四路径之一 + 已结清数量，结案时校验 ordered = shipped + resolved
  tailPlan        TailPlan? @map("tail_plan")
  tailResolvedQty Decimal   @default(0) @map("tail_resolved_qty") @db.Decimal(18, 6)
  tailApprovedBy  String?   @map("tail_approved_by") @db.VarChar(32)
  tailApprovedAt  DateTime? @map("tail_approved_at")
  tailRemark      String?   @map("tail_remark") @db.VarChar(500)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, sequence])
  @@index([orderLineId])
  @@index([drawingNo])
  @@map("shipment_lines")
}

/// 对账单状态。争议（DISPUTED）不是终点：差异回到源单处理后重新发出。
enum StatementStatus {
  DRAFT
  SENT
  CONFIRMED
  DISPUTED
  SETTLED

  @@map("statement_status")
}

/// 对账明细行的单据类型；前端展示为 发货 / 开票 / 回款 / 退货 / 折让。
enum StatementLineType {
  SHIPMENT
  INVOICE
  RECEIPT
  RETURN
  ALLOWANCE

  @@map("statement_line_type")
}

/// 客户对账单：按客户与期间从源单汇总，金额业务不得手工修改。
/// 重算生成新版本（version 递增），已发出的版本原样保留。
model Statement {
  id    String @id @default(uuid()) @db.Uuid
  docNo String @unique @map("doc_no") @db.VarChar(32)

  customerId String   @map("customer_id") @db.Uuid
  periodFrom DateTime @map("period_from") @db.Date
  periodTo   DateTime @map("period_to") @db.Date
  currency   String   @default("CNY") @db.VarChar(8)
  /// 重算版本号，从 1 起；同一客户同一期间可以有多版
  version    Int      @default(1)

  openingBalanceMinor BigInt @map("opening_balance_minor")
  shippedAmountMinor  BigInt @map("shipped_amount_minor")
  invoicedAmountMinor BigInt @map("invoiced_amount_minor")
  receivedAmountMinor BigInt @map("received_amount_minor")
  returnAmountMinor   BigInt @map("return_amount_minor")
  closingBalanceMinor BigInt @map("closing_balance_minor")

  /// 与客户账面的差异；非零时 differenceNote 必填
  differenceAmountMinor BigInt  @map("difference_amount_minor")
  differenceNote        String? @map("difference_note") @db.VarChar(500)
  overdueAmountMinor    BigInt  @map("overdue_amount_minor")

  status        StatementStatus @default(DRAFT)
  ownerUserCode String          @map("owner_user_code") @db.VarChar(32)
  sentAt        DateTime?       @map("sent_at")
  confirmedAt   DateTime?       @map("confirmed_at")

  lines StatementLine[]

  createdBy   String?  @map("created_by") @db.VarChar(32)
  updatedBy   String?  @map("updated_by") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  versionLock Int      @default(0) @map("version_lock")

  @@unique([customerId, periodFrom, periodTo, version])
  @@index([customerId, status])
  @@map("statements")
}

/// 对账明细行。金额由源单带出，客户核对状态（matched）是唯一可改字段。
model StatementLine {
  id          String @id @default(uuid()) @db.Uuid
  statementId String @map("statement_id") @db.Uuid
  sequence    Int

  occurredAt  DateTime          @map("occurred_at") @db.Date
  type        StatementLineType
  docNo       String            @map("doc_no") @db.VarChar(32)
  productName String?           @map("product_name") @db.VarChar(128)
  quantity    Decimal?          @db.Decimal(18, 6)
  /// 回款与退货折让为负数，直接相加即得期末余额
  amountMinor BigInt            @map("amount_minor")
  matched     Boolean           @default(false)
  remark      String?           @db.VarChar(255)

  statement Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@unique([statementId, sequence])
  @@index([docNo])
  @@map("statement_lines")
}

// ───────────────────────────── invoice-request（发票申请，业务规格第 9 章）

/// 发票种类。与前端 `InvoiceType` 一一对应。
enum InvoiceKind {
  /// 增值税专用发票
  SPECIAL
  /// 增值税普通发票
  GENERAL
  /// 出口发票（零税率）
  EXPORT
  /// 形式发票 Proforma
  PROFORMA

  @@map("invoice_kind")
}

/// 正票与红字发票共用一张表：红冲就是「带负号且挂着父单」的发票申请。
/// 一套状态机、一条编号流、一个列表端点，前端不用为红冲另做一套。
enum InvoiceDocKind {
  INVOICE
  CREDIT_NOTE

  @@map("invoice_doc_kind")
}

/// 走共享 DocStatus 的取值，不另造一套词汇：
/// SUBMITTED=待复核，REVIEWING=财务开票中，COMPLETED=已开票交付。
/// 寄出与签收**不是状态**，是 COMPLETED 之后的两个时间戳事件。
enum InvoiceRequestStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  COMPLETED
  REJECTED
  VOID

  @@map("invoice_request_status")
}

/// 发票申请。业务按已签收出货单发起，财务开票并回写发票号。
model InvoiceRequest {
  id    String @id @default(uuid()) @db.Uuid
  docNo String @unique @map("doc_no") @db.VarChar(32)

  kind       InvoiceDocKind @default(INVOICE)
  /// 红字发票指向被红冲的正票；正票为空
  originalId String?        @map("original_id") @db.Uuid

  customerId String      @map("customer_id") @db.Uuid
  invoiceKind InvoiceKind @map("invoice_kind")
  /// 按期间开票时关联的对账单
  statementId String?    @map("statement_id") @db.Uuid

  currency          String @default("CNY") @db.VarChar(8)
  amountExTaxMinor  BigInt @map("amount_ex_tax_minor")
  taxAmountMinor    BigInt @map("tax_amount_minor")
  amountIncTaxMinor BigInt @map("amount_inc_tax_minor")

  /// 开票信息，建单时从客户档案带出后冻结——客户档案后来改了不该改动已开的票
  title       String  @db.VarChar(191)
  taxNo       String  @map("tax_no") @db.VarChar(64)
  bankAccount String? @map("bank_account") @db.VarChar(191)
  address     String? @db.VarChar(255)

  deliveryMethod String @map("delivery_method") @db.VarChar(32)
  deliveryTarget String @map("delivery_target") @db.VarChar(191)

  /// 出货 / 对账 / 申请三方金额是否一致；不一致禁止送财务开票
  amountMatched Boolean @default(true) @map("amount_matched")
  matchNote     String? @map("match_note") @db.VarChar(500)

  expectedPaymentDate DateTime? @map("expected_payment_date")

  status        InvoiceRequestStatus @default(DRAFT)
  ownerUserCode String               @map("owner_user_code") @db.VarChar(32)
  submittedAt   DateTime?            @map("submitted_at")

  /// 财务回写
  invoiceNo String?   @map("invoice_no") @db.VarChar(64)
  issuedAt  DateTime? @map("issued_at")
  /// 寄出与签收：状态仍是 COMPLETED，这两个只推进时间线
  sentAt    DateTime? @map("sent_at")
  signedAt  DateTime? @map("signed_at")

  /// 作废（未开票前）与红冲（已开票后）都必须写明理由
  reasonText String? @map("reason_text") @db.VarChar(500)

  lines       InvoiceRequestLine[]
  original    InvoiceRequest?      @relation("CreditNoteOf", fields: [originalId], references: [id])
  creditNotes InvoiceRequest[]     @relation("CreditNoteOf")

  createdBy   String?  @map("created_by") @db.VarChar(32)
  updatedBy   String?  @map("updated_by") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  versionLock Int      @default(0) @map("version_lock")

  @@index([customerId, status])
  @@index([status, issuedAt])
  @@index([originalId])
  @@map("invoice_requests")
}

/// 发票明细行。逐行挂在出货单上，金额与出货一致是硬规则。
model InvoiceRequestLine {
  id        String @id @default(uuid()) @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  sequence  Int

  shipmentId String? @map("shipment_id") @db.Uuid
  shipmentNo String  @map("shipment_no") @db.VarChar(32)

  productName String @map("product_name") @db.VarChar(128)
  drawingNo   String @map("drawing_no") @db.VarChar(128)

  quantity       Decimal @db.Decimal(18, 6)
  unitPriceMinor BigInt  @map("unit_price_minor")
  amountMinor    BigInt  @map("amount_minor")
  /// 税率按万分比存整数（1300 = 13%）
  taxRateBps     Int     @map("tax_rate_bps")
  taxAmountMinor BigInt  @map("tax_amount_minor")

  invoice InvoiceRequest @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, sequence])
  @@index([shipmentId])
  @@map("invoice_request_lines")
}

/// 销退 / RMA 状态（业务规格第 8 章，与前端 ReturnStatus 一一对应）。
/// REJECTED = 客诉不成立，是终点；DISPOSITION 是处置方案审批中。
enum SalesReturnStatus {
  REGISTERED
  QUALITY_JUDGING
  DISPOSITION
  EXECUTING
  CLOSED
  REJECTED

  @@map("sales_return_status")
}

/// 责任归属。**逐行判定**：一张 RMA 里本厂加工不良与委外表处不良可以同时存在，
/// 一个单头字段说不清这件事，分析报表也是按批（= 行）统计的。
enum ReturnResponsibility {
  COMPANY
  CUSTOMER
  SUPPLIER
  UNDECIDED

  @@map("return_responsibility")
}

/// 处置方式。**逐行**，与前端 DISPOSITION 字典同集合。
/// 客户 8D 不在这里——8D 是并行的品质流程（见 SalesReturn.eightDNo），
/// 可以伴随任何一种处置；物理退货入库也不在这里，那是仓储事实（见 receivedAt）。
enum ReturnDisposition {
  REFUND
  REPLACEMENT
  REWORK
  CONCESSION
  SCRAP
  UNDECIDED

  @@map("return_disposition")
}

/// 客诉 / 退货单（RMA）。关联原订单与原出货批次，一张单可退多项产品。
///
/// 单头**不存**责任归属与处置方式：那两个字段逐行判定，单头展示值由 DTO
/// 映射器按「全行一致取该值，否则标记为按行」现算——存一份派生值只会腐坏。
model SalesReturn {
  id    String @id @default(uuid()) @db.Uuid
  docNo String @unique @map("doc_no") @db.VarChar(32)

  orderId    String  @map("order_id") @db.Uuid
  shipmentId String? @map("shipment_id") @db.Uuid
  customerId String  @map("customer_id") @db.Uuid

  currency String @default("CNY") @db.VarChar(8)

  /// 客诉摘要（单头层面的一句话描述）；逐行的具体不良写在行上
  reason String @db.VarChar(500)

  /// 8D 是与处置正交的品质流程轨道，可伴随任意处置组合
  eightDNo       String?  @map("eight_d_no") @db.VarChar(32)
  eightDRequired Boolean  @default(false) @map("eight_d_required")

  status        SalesReturnStatus @default(REGISTERED)
  ownerUserCode String            @map("owner_user_code") @db.VarChar(32)

  complaintAt DateTime  @map("complaint_at")
  /// 首次响应时间，SLA 统计口径
  respondedAt DateTime? @map("responded_at")
  /// 品质判定完成
  judgedAt    DateTime? @map("judged_at")
  judgedBy    String?   @map("judged_by") @db.VarChar(32)
  /// 处置方案审批
  approvedAt  DateTime? @map("approved_at")
  approvedBy  String?   @map("approved_by") @db.VarChar(32)
  /// **结案即入账**：对账单的退货折让列按 closedAt 所在期间计入，
  /// 同时锁死各行金额与处置——之后要更正只能另开单据。
  closedAt    DateTime? @map("closed_at")

  /// 涉及退款 / 让步 / 补货时按控制矩阵升级财务与总经办；由处置组合推导后落库
  needFinanceApproval Boolean @default(false) @map("need_finance_approval")
  /// 判定不成立的理由；REJECTED 时必填
  rejectReason        String? @map("reject_reason") @db.VarChar(500)

  lines SalesReturnLine[]

  createdBy   String?  @map("created_by") @db.VarChar(32)
  updatedBy   String?  @map("updated_by") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  versionLock Int      @default(0) @map("version_lock")

  @@index([customerId, status])
  @@index([orderId])
  @@index([shipmentId])
  @@index([customerId, closedAt])
  @@map("sales_returns")
}

/// 退货明细行——责任归属与处置方式的**唯一真相所在**。
model SalesReturnLine {
  id       String @id @default(uuid()) @db.Uuid
  returnId String @map("return_id") @db.Uuid
  sequence Int

  /// 关联原出货行与原订单行，用于数量校验与批次追溯
  shipmentLineId String? @map("shipment_line_id") @db.Uuid
  orderLineId    String? @map("order_line_id") @db.Uuid

  productName String @map("product_name") @db.VarChar(128)
  drawingNo   String @map("drawing_no") @db.VarChar(128)
  batchNo     String @map("batch_no") @db.VarChar(64)

  returnQty      Decimal @map("return_qty") @db.Decimal(18, 6)
  unitPriceMinor BigInt  @map("unit_price_minor")
  /// 该行涉及货值 = 退货数 × 单价
  amountMinor    BigInt  @map("amount_minor")

  /// 该行的具体不良现象；分析报表按 reason 归集
  reason String @db.VarChar(500)

  responsibility ReturnResponsibility @default(UNDECIDED)
  disposition    ReturnDisposition    @default(UNDECIDED)
  /// 退款 / 让步 / 报废动钱，理由必填
  dispositionNote String? @map("disposition_note") @db.VarChar(500)

  /// 让步接收时与客户谈定的减价金额。**只有 CONCESSION 用**，
  /// 且必须录入——让步减多少是谈出来的，系统推算不出来。
  allowanceMinor BigInt? @map("allowance_minor")

  /// 物理退货入库（不良仓）。返工必须先收到不良品才能开工。
  receivedAt  DateTime? @map("received_at")
  receivedQty Decimal?  @map("received_qty") @db.Decimal(18, 6)

  /// 该行的扣减是否已由红字发票承接。开票制口径下用它避免重复冲减；
  /// 发货制口径下红字只影响开票列，不影响期末余额，因此不看这个标志。
  settledByCreditNote Boolean @default(false) @map("settled_by_credit_note")
  creditNoteDocNo     String? @map("credit_note_doc_no") @db.VarChar(32)

  salesReturn SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@unique([returnId, sequence])
  @@index([shipmentLineId])
  @@index([orderLineId])
  @@index([batchNo])
  @@map("sales_return_lines")
}

/// 报关资料状态（业务规格第 10 章，与前端 CustomsStatus 一一对应）。
/// 申报（DECLARED）是不可变边界：在此之前改文件是日常迭代，在此之后必须走更正记录。
enum CustomsStatus {
  DRAFT
  CHECKING
  GENERATED
  DECLARED
  RELEASED

  @@map("customs_status")
}

/// 报关文件种类（业务规格第 10 章）。
///
/// **形式发票与商业发票是两份不同的单据**，不是一份的两种叫法：
/// 形式发票在出货前按订单数据开，用途是开信用证与收预付款；
/// 商业发票在出货后按实发数量与重量开，是海关据以清关的那一份。
/// 报关数据包引用的永远是**商业**发票。
enum CustomsDocKind {
  PROFORMA_INVOICE
  COMMERCIAL_INVOICE
  PACKING_LIST
  CONTRACT
  DATA_PACK

  @@map("customs_doc_kind")
}

/// 报关资料（EXP-01~04）。外贸出货在发货后生成整包资料，关务复核后申报。
model CustomsDossier {
  id    String @id @default(uuid()) @db.Uuid
  docNo String @unique @map("doc_no") @db.VarChar(32)

  shipmentId String @map("shipment_id") @db.Uuid
  orderId    String @map("order_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  /// 贸易要素
  tradeMode      String  @map("trade_mode") @db.VarChar(32)
  incoterm       String  @db.VarChar(32)
  portOfLoading  String  @map("port_of_loading") @db.VarChar(64)
  destination    String  @db.VarChar(128)
  /// 目的港代码与唛头：清关必需要素，齐套校验会点名要它们
  destinationPortCode String? @map("destination_port_code") @db.VarChar(16)
  shippingMarks       String? @map("shipping_marks") @db.VarChar(500)

  /// 商品要素
  hsCode      String  @map("hs_code") @db.VarChar(16)
  goodsNameCn String  @map("goods_name_cn") @db.VarChar(128)
  goodsNameEn String? @map("goods_name_en") @db.VarChar(128)
  quantity    Decimal @db.Decimal(18, 6)
  unit        String  @db.VarChar(16)
  netWeight   Decimal @map("net_weight") @db.Decimal(18, 3)
  grossWeight Decimal @map("gross_weight") @db.Decimal(18, 3)
  packages    Int

  currency         String @db.VarChar(8)
  unitPriceMinor   BigInt @map("unit_price_minor")
  totalAmountMinor BigInt @map("total_amount_minor")
  /// 单据上的汇率是**每份文件各自出具时的快照**（见 CustomsDocument.exchangeRate）；
  /// 这里存的是资料包建档时的当日汇率，只作缺省值与展示
  exchangeRate     Decimal @map("exchange_rate") @db.Decimal(18, 6)

  status        CustomsStatus @default(DRAFT)
  ownerUserCode String        @map("owner_user_code") @db.VarChar(32)

  /// 关务复核不可跳过
  checkedBy String?   @map("checked_by") @db.VarChar(32)
  checkedAt DateTime? @map("checked_at")

  /// 已申报的次数；每次更正后重新申报递增。0 = 尚未申报
  declarationVersion Int       @default(0) @map("declaration_version")
  declaredAt         DateTime? @map("declared_at")
  releasedAt         DateTime? @map("released_at")

  documents    CustomsDocument[]
  declarations CustomsDeclaration[]
  corrections  CustomsCorrection[]

  createdBy   String?  @map("created_by") @db.VarChar(32)
  updatedBy   String?  @map("updated_by") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  versionLock Int      @default(0) @map("version_lock")

  @@index([customerId, status])
  @@index([shipmentId])
  @@index([orderId])
  @@map("customs_dossiers")
}

/// 报关文件的一个**版本**。每次生成产生新的一行，旧行原样保留——
/// 「已提交版本只能更正或生成新版本，不能覆盖」（业务规格第 10 章）。
model CustomsDocument {
  id        String         @id @default(uuid()) @db.Uuid
  dossierId String         @map("dossier_id") @db.Uuid
  kind      CustomsDocKind
  version   Int

  /// 文件落在 object-storage 上的位置；生成失败或尚未出文件时为空
  objectKey String? @map("object_key") @db.VarChar(512)
  fileName  String? @map("file_name") @db.VarChar(256)

  /// **每份文件在自己出具的那一刻各留一份汇率快照**（业务规格第 10 章
  /// 「汇率取当日汇率表并保存快照」）。同一个资料包里先后出的两份文件汇率可以不同，
  /// 这不是 bug——它们本来就是不同日子出具的单据。
  exchangeRate Decimal @map("exchange_rate") @db.Decimal(18, 6)
  currency     String  @db.VarChar(8)

  generatedAt DateTime @default(now()) @map("generated_at")
  generatedBy String   @map("generated_by") @db.VarChar(32)

  dossier CustomsDossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@unique([dossierId, kind, version])
  @@index([dossierId, kind])
  @@map("customs_documents")
}

/// 一次申报的**清单快照**：这一版申报到底送出去了哪几份文件的哪几版。
///
/// 单独一张表而不是几个字段，是因为「送出去的是什么」必须能原样复现——
/// 事后任何一份文件再出新版都不允许改动这张快照。
model CustomsDeclaration {
  id        String @id @default(uuid()) @db.Uuid
  dossierId String @map("dossier_id") @db.Uuid
  version   Int

  declaredAt DateTime @map("declared_at")
  declaredBy String   @map("declared_by") @db.VarChar(32)

  /// 申报回执归档（业务规格第 10 章）；按申报版本各自挂各自的回执
  receiptNo String?   @map("receipt_no") @db.VarChar(64)
  receiptAt DateTime? @map("receipt_at")

  lines   CustomsDeclarationLine[]
  dossier CustomsDossier          @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@unique([dossierId, version])
  @@map("customs_declarations")
}

/// 申报清单的一行：某种文件的某一版被这次申报纳入。
model CustomsDeclarationLine {
  id            String         @id @default(uuid()) @db.Uuid
  declarationId String         @map("declaration_id") @db.Uuid
  kind          CustomsDocKind
  version       Int

  declaration CustomsDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  @@unique([declarationId, kind])
  @@map("customs_declaration_lines")
}

/// 申报之后的更正记录。**理由必填**——已申报的资料是对海关的正式陈述，
/// 改它必须说得清为什么（业务规格第 10 章「只能更正或生成新版本」）。
///
/// 申报之前的重新生成不进这张表：那是日常迭代，有审计日志就够了，
/// 强制填理由只会逼出一堆「修改」二字的样板文字。
model CustomsCorrection {
  id        String @id @default(uuid()) @db.Uuid
  dossierId String @map("dossier_id") @db.Uuid
  sequence  Int

  reason String @db.VarChar(500)
  /// 本次更正重出了哪几份文件、从哪一版到哪一版
  lines  CustomsCorrectionLine[]

  /// 更正后重新申报所产生的申报版本号
  resultingDeclarationVersion Int @map("resulting_declaration_version")

  createdBy String   @map("created_by") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")

  dossier CustomsDossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@unique([dossierId, sequence])
  @@map("customs_corrections")
}

model CustomsCorrectionLine {
  id           String         @id @default(uuid()) @db.Uuid
  correctionId String         @map("correction_id") @db.Uuid
  kind         CustomsDocKind
  fromVersion  Int            @map("from_version")
  toVersion    Int            @map("to_version")

  correction CustomsCorrection @relation(fields: [correctionId], references: [id], onDelete: Cascade)

  @@unique([correctionId, kind])
  @@map("customs_correction_lines")
}

/* ============================== docgen 单据出具 ============================== */

/// 一次**出具**的留痕。
///
/// 为什么要有这张表：development-guide §6.1 要求「新文件种类必须能在线预览」，
/// 而预览按 `(ownerType, ownerId)` 定位——没有行就没有 ownerId，预览就接不上。
/// 顺带解决第二件事：客户拿着半年前那份报价单来问「这数怎么来的」，
/// 得先知道它是**哪一版模板**出的。
///
/// ⚠️ 它**不是单据**，是单据的生成物，因此**刻意没有** doc_no / 状态机 / 乐观锁：
/// development-guide 第 4 节那三样是对「有生命周期的单据」的要求。
/// 这里的一行一旦写下就不再变化——要新的就再出一份，旧的原样留着，
/// 与报关文件版本链、发票红冲是同一条「已出具即不可变」的规矩。
model GeneratedDocument {
  id String @id @default(uuid()) @db.Uuid

  /// 出具所依据的单据。不做外键：docgen 服务于所有模块的单据，
  /// 逐一建关系会把这张表变成全库的汇合点，反而绑死了模块边界。
  sourceType String @map("source_type") @db.VarChar(32)
  sourceId   String @map("source_id") @db.Uuid
  /// 冗余一份来源单号，供列表直接展示与审计认单，免去回查
  sourceDocNo String @map("source_doc_no") @db.VarChar(64)

  templateId      String @map("template_id") @db.VarChar(64)
  /// 出具时模板是第几版——模板改版后旧文件要能解释得清
  templateVersion Int    @map("template_version")

  objectKey String @map("object_key") @db.VarChar(512)
  fileName  String @map("file_name") @db.VarChar(256)
  sizeBytes Int    @map("size_bytes")

  /// 合并导出时被合进来的单据份数；单份出具为 1
  documentCount Int @default(1) @map("document_count")

  generatedAt DateTime @default(now()) @map("generated_at")
  generatedBy String   @map("generated_by") @db.VarChar(32)

  @@index([sourceType, sourceId])
  @@index([generatedBy, generatedAt])
  @@map("generated_documents")
}

/* ============================== ECN 工程变更申请 ============================== */

/// ECN 受理的变更类型（业务规格第 6 章）。
///
/// **只受理「产品本身」的变更**：改图、改材料、改表面处理，以及由此必须
/// 同步的工艺路线变更。数量 / 交期 / 收货信息 / 包装走订单修改申请（ORC），
/// 价格走报价单修改申请（QRC）——这三条边界由服务端硬拦，见 ecn-scope.rules.ts。
///
/// `PROCESS` 单列而不是并进 DRAWING：内部发起的工序改善（换装夹、并工序）
/// 图纸并不变，却真实存在且要限批次生效。把它塞进改图，等于逼人伪造一次图纸变更。
enum EcnChangeType {
  DRAWING
  MATERIAL
  SURFACE
  PROCESS

  @@map("ecn_change_type")
}

enum EcnOrigin {
  CUSTOMER
  INTERNAL

  @@map("ecn_origin")
}

/// 八态，与前端 `EcnStatus` 一一对应——界面是设计基线，后端照着它建。
enum EcnStatus {
  DRAFT
  SUBMITTED
  ASSESSING
  REVIEWING
  APPROVED
  EXECUTING
  CLOSED
  REJECTED

  @@map("ecn_status")
}

/// 影响范围四项。固定枚举而非自由文本：这四项是**评估完整性的判据**
/// （四项齐了才允许送会签），自由文本没法判断「评没评全」。
enum EcnImpactScope {
  /// 在制工单
  WIP
  /// 已采购物料
  PURCHASED
  /// 已完工库存
  FINISHED_STOCK
  /// 已发货批次
  SHIPPED

  @@map("ecn_impact_scope")
}

model EcnRequest {
  id    String @id @default(uuid()) @db.Uuid
  docNo String @unique @map("doc_no") @db.VarChar(64)

  customerId String  @map("customer_id") @db.Uuid
  /// 可空：内部发起的工艺改善未必挂在某一张订单上
  orderId    String? @map("order_id") @db.Uuid

  productName String @map("product_name") @db.VarChar(128)
  drawingNo   String @map("drawing_no") @db.VarChar(64)

  /// 变更链路：图纸版本 ↔ BOM ↔ 报价版本，三者串起来才追得到「这个改动从哪来、影响到谁」
  drawingVersionId    String? @map("drawing_version_id") @db.Uuid
  /// 改图后的新版本；由 quotation 的图纸上传通道产生，本模块不另建上传路径
  newDrawingVersionId String? @map("new_drawing_version_id") @db.Uuid
  bomRequestId        String? @map("bom_request_id") @db.Uuid
  quotationId         String? @map("quotation_id") @db.Uuid

  changeType EcnChangeType @map("change_type")
  origin     EcnOrigin
  urgent     Boolean       @default(false)

  beforeValue String @map("before_value") @db.VarChar(1000)
  afterValue  String @map("after_value") @db.VarChar(1000)
  reason      String @db.VarChar(1000)

  /// 改图必须联动改工艺路线；未同步不允许批准发布（第 6 章硬规则）
  routingUpdated Boolean @default(false) @map("routing_updated")
  /// 中途改工序只能对指定批次版本生效，否则已投产批次会被无声地改掉
  effectiveBatch String? @map("effective_batch") @db.VarChar(64)

  /// 只做标记与提醒，**不代建** QRC / ORC：重新核价要填成本变化、
  /// 订单修改要填改什么，这些信息 ECN 里没有，代建只会产出一批空壳单据。
  needRequote         Boolean @default(false) @map("need_requote")
  needOrderReapproval Boolean @default(false) @map("need_order_reapproval")

  status        EcnStatus @default(DRAFT)
  ownerUserCode String    @map("owner_user_code") @db.VarChar(32)

  submittedAt  DateTime? @map("submitted_at")
  assessedBy   String?   @map("assessed_by") @db.VarChar(32)
  assessedAt   DateTime? @map("assessed_at")
  approvedBy   String?   @map("approved_by") @db.VarChar(32)
  approvedAt   DateTime? @map("approved_at")
  closedAt     DateTime? @map("closed_at")
  rejectReason String?   @map("reject_reason") @db.VarChar(500)

  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by") @db.VarChar(32)
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by") @db.VarChar(32)
  versionLock Int      @default(0) @map("version_lock")

  impacts  EcnImpact[]
  signoffs EcnSignoff[]

  @@index([customerId, status])
  @@index([orderId])
  @@index([ownerUserCode, status])
  @@map("ecn_requests")
}

model EcnImpact {
  id    String         @id @default(uuid()) @db.Uuid
  ecnId String         @map("ecn_id") @db.Uuid
  scope EcnImpactScope

  /// 数量是**描述性文字**而非数字：真实评估写的是「1200 件」「304 棒料 620kg」
  /// 「5000 件用量」，单位与口径各不相同，强行数字化会丢掉评估本身的信息
  quantity String @db.VarChar(128)
  /// 金额影响；评不出金额时为空（前端显示为「—」），**不填 0**——
  /// 0 是「评估过且为零」，空是「这一项算不出钱」，两者在返工决策里含义相反
  amountMinor BigInt? @map("amount_minor")
  note        String  @db.VarChar(500)

  ecn EcnRequest @relation(fields: [ecnId], references: [id], onDelete: Cascade)

  @@unique([ecnId, scope])
  @@map("ecn_impacts")
}

/// 跨部门会签（ECN-03）。
///
/// ⚠️ PMC / 采购 / 生产 / 品质 / 财务五个模块尚未上线，现阶段由工程岗代签，
/// 每条记录都会写明代签人。表结构按最终形态建，各部门模块上线时只换签收人来源，
/// 状态机与端点契约不动——与分析层那四个 STUB 读端口同一套做法。
model EcnSignoff {
  id         String @id @default(uuid()) @db.Uuid
  ecnId      String @map("ecn_id") @db.Uuid
  department String @db.VarChar(32)

  signedBy String?   @map("signed_by") @db.VarChar(32)
  signedAt DateTime? @map("signed_at")
  opinion  String?   @db.VarChar(500)
  /// 是否由工程代签（各部门模块未上线期间为 true），审计里要能一眼看出来
  proxied  Boolean   @default(false)

  ecn EcnRequest @relation(fields: [ecnId], references: [id], onDelete: Cascade)

  @@unique([ecnId, department])
  @@map("ecn_signoffs")
}
