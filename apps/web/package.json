{
  "name": "@machining-erp/web",
  "version": "0.1.0",
  "private": true,
  "description": "MachiningERP 内部十部门前端（Vue 3 + Vite + TypeScript）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "pretypecheck": "pnpm -F @machining-erp/shared build",
    "prebuild": "pnpm -F @machining-erp/shared build",
    "predev": "pnpm -F @machining-erp/shared build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.8.8",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "xlsx": "^0.18.5",
    "@machining-erp/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
