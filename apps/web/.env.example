# 接口基地址（生产由网关注入）
VITE_API_BASE_URL=/api/v1

# 前端 mock 开关。
#   true  —— 全部走 src/api/mock/（后端未启动时也能演示）
#   false —— 走 services/api 真实后端（需先 pnpm db:up && pnpm db:migrate && pnpm db:seed && pnpm dev:api）
# 未显式配置时：开发态默认开启、生产构建默认关闭。
# auth 模块已上线，登录、申请账户、忘记密码、部门下拉均可切 false 实测。
VITE_USE_MOCK=true

# pnpm dev 时 /api 代理指向的后端
VITE_API_PROXY_TARGET=http://localhost:3000
