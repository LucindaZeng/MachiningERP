{
  "name": "machining-erp",
  "version": "0.1.0",
  "private": true,
  "description": "万富鑫制造业 ERP —— pnpm monorepo 根（结构见 docs/development/development-guide.md 第 1 节）",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:web": "pnpm -F @machining-erp/web dev",
    "dev:api": "pnpm -F @machining-erp/api start:dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,json,md,yml,yaml}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:cov": "pnpm -r test:cov",
    "db:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.dev.yml down",
    "stack:up": "docker compose -f infra/docker-compose.local.yml up -d",
    "stack:down": "docker compose -f infra/docker-compose.local.yml down",
    "db:migrate": "pnpm -F @machining-erp/api prisma:migrate",
    "db:seed": "pnpm -F @machining-erp/api prisma:seed",
    "check:repo": "python3 tools/check_repository.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.2",
    "vue-eslint-parser": "^9.4.3"
  }
}
