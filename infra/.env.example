# ---------------------------------------------------------------------------
# MachiningERP 环境变量模板（development-guide 第 5 节）
# 复制为 infra/.env 与 services/api/.env 后按本机情况修改；密钥不进仓库。
# ---------------------------------------------------------------------------

# --- 数据库 ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=machining_erp
DATABASE_URL=postgresql://erp:erp_dev_password@localhost:5432/machining_erp?schema=public

# --- 缓存与对象存储 ---
REDIS_URL=redis://localhost:6379
MINIO_ROOT_USER=erp
MINIO_ROOT_PASSWORD=erp_dev_password
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=machining-erp
# 预签名给 kkFileView 用的端点：必须是**容器可达**地址。
# compose 内走服务名；容器里的 localhost 是 kkFileView 自己，签在 localhost 上取不到文件。
S3_PREVIEW_ENDPOINT=http://minio:9000

# --- 在线预览（kkFileView） ---
# 本地直连 8012；生产经 Nginx 反代改为 https://<域名>/preview
KK_PREVIEW_BASE_URL=http://localhost:8012
# 预签名有效期（秒），上限 300，超出自动截断
KK_PREVIEW_TTL_SECONDS=180

# --- 文件上传 ---
# 单文件上限（字节），默认 50MB
UPLOAD_MAX_BYTES=52428800

# --- API ---
API_PORT=3000
API_GLOBAL_PREFIX=api/v1
NODE_ENV=development

# --- 认证 ---
# 生产必须改为强随机值并由密钥管理下发
JWT_SECRET=change-me-in-production-at-least-32-characters
JWT_EXPIRES_IN=8h
# 连续登录失败达到该次数后强制图形验证码
LOGIN_CAPTCHA_THRESHOLD=3
# 连续登录失败达到该次数后临时锁定
LOGIN_LOCK_THRESHOLD=8
# 临时锁定时长（分钟）
LOGIN_LOCK_MINUTES=30
# 图形验证码有效期（秒）
CAPTCHA_TTL_SECONDS=120

# --- 首个管理员（仅 seed 使用） ---
SEED_ADMIN_ACCOUNT=admin
SEED_ADMIN_PASSWORD=Wfx@2026
